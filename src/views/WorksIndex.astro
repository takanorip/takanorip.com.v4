---
import Base from "../layouts/Base.astro";
import Works from "../components/Works/index";
import { fetchWorks } from "../lib/cms";
import { localizeWork } from "../i18n/works";
import { ui } from "../i18n/ui";
import type { Locale } from "../i18n/path";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const works = (await fetchWorks()).map((work) => localizeWork(work, locale));
---

<Base
  locale={locale}
  dir="works"
  title={copy.worksTitle}
  description={copy.worksDescription}
>
  <Works works={works} locale={locale} client:visible />
</Base>

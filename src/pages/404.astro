---
import Base from "../layouts/Base.astro";
---

<Base locale="ja" title="Not Found" description="Page not found" pathname="/">
  <div class="notFound">
    <h1>Page not found</h1>
    <p>お探しのページは見つかりませんでした。</p>
    <p>This page could not be found.</p>
    <p class="links">
      <a href="/">日本語</a>
      <a href="/en">English</a>
    </p>
  </div>
</Base>

<style>
  .notFound {
    max-width: 720px;
    padding: 128px var(--spacing-5) var(--spacing-13);
    margin: 0 auto;
  }

  .notFound h1 {
    margin-bottom: var(--spacing-3);
    font-size: var(--font-size-h3);
  }

  .notFound p + p {
    margin-top: var(--spacing-2);
  }

  .links {
    display: flex;
    gap: var(--spacing-3);
  }
</style>
